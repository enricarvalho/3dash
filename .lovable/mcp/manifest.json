          "properties": {
            "search": {
              "description": "Filtro por nome do item.",
              "type": "string"
            },
            "only_low": {
              "description": "Retornar apenas itens abaixo do estoque mínimo.",
              "type": "boolean"
            },
            "limit": {
              "description": "Máximo de itens (padrão 50).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
